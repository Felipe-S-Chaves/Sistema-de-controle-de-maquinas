# ---- Servidor ----
NODE_ENV=development
PORT=3000
# Origens permitidas pelo CORS (separadas por virgula). Use * apenas em desenvolvimento.
CORS_ORIGINS=http://localhost:3000

# ---- Banco de dados MySQL ----
# ATENCAO: DB_PASSWORD nao e uma senha que voce escolhe agora.
#  - Se DB_USER=root, ela precisa ser a senha que o MySQL JA TEM para o root
#    (a que voce definiu ao instalar o MySQL).
#  - Se quiser uma senha propria, use um usuario dedicado: escolha um DB_USER
#    diferente de root, defina a senha aqui e rode "npm run db:setup".
# Rode "npm run db:setup" para criar os bancos e o usuario, e "npm run db:check"
# para diagnosticar qualquer erro de conexao.
DB_HOST=localhost
DB_PORT=3306
DB_USER=mm_user
DB_PASSWORD=troque_esta_senha
DB_NAME=music_machines
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=-03:00

# ---- Autenticacao ----
# Gere um valor longo e aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_segredo_por_um_valor_longo_e_aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ---- Usuario administrador criado pelo seed ----
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.local
ADMIN_PASSWORD=Admin@123

# ---- Uploads ----
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=8
MAX_FILES_PER_COLLECTION=8

# ---- Fuso horario da aplicacao ----
APP_TIMEZONE=America/Sao_Paulo
